# Cross-protocol client-request rate limiting (token bucket). One limiter is
# shared by the TCP, WebSocket, and HTTP-ingress transports, so a client's
# quota is unified regardless of which protocol it uses. All values are
# optional; the defaults shown here apply when unset.
# See wiki/01-overview-and-features.md (Cross-protocol rate limiting).
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_AUTH_RPS="50"
RATE_LIMIT_AUTH_BURST="100"
RATE_LIMIT_ANON_RPS="10"
RATE_LIMIT_ANON_BURST="20"
RATE_LIMIT_GLOBAL_RPS="5000"
RATE_LIMIT_GLOBAL_BURST="10000"
RATE_LIMIT_IDLE_EVICT_SECS="300"

TELEMETRY_API_PORT="9099"
TELEMETRY_DB_PATH=""

# ── Modal sandbox runtime (VM plugin key: `modal`) ─────────────────────────
# The credential pair Modal issues under Settings → API Tokens. Either give
# them together as MODAL_API_KEY ("<token-id>:<token-secret>") or separately.
# With neither set the plugin still registers, and every modal operation fails
# with "modal runtime is not configured" rather than a transport error.
MODAL_API_KEY=""
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""
# Modal workspace environment (blank = the workspace default).
MODAL_ENVIRONMENT=""
# Control-plane endpoint. Only set this to reach a non-production Modal.
MODAL_SERVER_URL="https://api.modal.com:443"
# Prefix for the Modal app and volume names this node creates, so several
# Caspar deployments can share one Modal workspace without colliding.
MODAL_APP_PREFIX="caspar"
# Image a sandbox boots from when the run packet names none.
MODAL_DEFAULT_IMAGE="ubuntu:24.04"
# Where each VM's persistent Modal Volume is mounted inside its sandbox.
MODAL_VOLUME_MOUNT_PATH="/data"
# Max lifetime of a sandbox in seconds when the run packet names none.
MODAL_SANDBOX_TIMEOUT_SECS="3600"
# How long an image build may take before the run gives up.
MODAL_IMAGE_BUILD_TIMEOUT_SECS="900"
